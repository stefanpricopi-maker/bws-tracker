---
import '../styles/global.css';
import BottomNav from '../components/BottomNav';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="BWS Tracker — strict, math-based fitness tracking" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · BWS Tracker</title>
  </head>
  <body
    class="min-h-screen flex flex-col"
    style="background-color: var(--color-bg); color: var(--color-text);"
  >
    <!-- Top header -->
    <header
      class="sticky top-0 z-30 flex items-center justify-between px-4 h-14 border-b"
      style="background-color: var(--color-surface); border-color: var(--color-border);"
    >
      <span class="text-base font-bold tracking-tight" style="color: var(--color-accent);">
        BWS
      </span>
      <h1 class="text-sm font-semibold tracking-wide uppercase" style="color: var(--color-muted);">
        {title}
      </h1>
      <!-- placeholder for future user avatar / settings icon -->
      <div class="w-7 h-7 rounded-full" style="background-color: var(--color-surface-2);"></div>
    </header>

    <!-- Page content — padded so it sits above the bottom nav -->
    <main class="flex-1 overflow-y-auto px-4 py-6 pb-24">
      <slot />
    </main>

    <!-- Mobile bottom navigation (React island) -->
    <BottomNav client:load />
  </body>
</html>
