---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'BWS Tracker' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · BWS</title>
  </head>

  <body class="bg-gray-900 text-white">
    <!--
      Mobile shell: centered column, max 28rem wide, full viewport height.
      On larger screens this creates the "phone on desktop" effect.
      The bottom nav is rendered by the Dashboard React component so tab state
      stays reactive without a full-page navigation.
    -->
    <div class="relative mx-auto flex min-h-screen max-w-md flex-col bg-gray-900">
      <slot />
    </div>
  </body>
</html>
