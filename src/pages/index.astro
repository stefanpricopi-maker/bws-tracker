---
import AppLayout from '../layouts/AppLayout.astro';
import { db } from '../db';
import { dailyLogs } from '../db/schema';
import { eq, desc } from 'drizzle-orm';

const USER_ID = 1;

const latest = await db
  .select()
  .from(dailyLogs)
  .where(eq(dailyLogs.userId, USER_ID))
  .orderBy(desc(dailyLogs.date))
  .limit(1)
  .get();

const today = new Date().toISOString().slice(0, 10);
const isLoggedToday = latest?.date === today;
---

<AppLayout title="Dashboard">
  <!-- Greeting -->
  <div class="mb-6">
    <p class="text-xs uppercase tracking-widest mb-1" style="color: var(--color-muted);">
      {new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}
    </p>
    <h2 class="text-2xl font-bold" style="color: var(--color-text);">Good day 👋</h2>
  </div>

  <!-- Today's log status banner -->
  <div
    class="rounded-2xl p-4 mb-5 flex items-center gap-3"
    style={`background-color: var(--color-surface); border: 1px solid ${isLoggedToday ? 'var(--color-success)' : 'var(--color-border)'};`}
  >
    <div
      class="w-9 h-9 rounded-full flex items-center justify-center text-lg flex-shrink-0"
      style={`background-color: ${isLoggedToday ? 'rgba(34,197,94,0.15)' : 'var(--color-surface-2)'};`}
    >
      {isLoggedToday ? '✓' : '○'}
    </div>
    <div>
      <p class="text-sm font-semibold" style="color: var(--color-text);">
        {isLoggedToday ? "Today's log complete" : "Today's log pending"}
      </p>
      <p class="text-xs" style="color: var(--color-muted);">
        {isLoggedToday
          ? `Weight: ${latest?.weightKg ?? '—'} kg · Cal: ${latest?.caloriesIn ?? '—'}`
          : 'Tap Log to record today's metrics'}
      </p>
    </div>
    {!isLoggedToday && (
      <a
        href="/log"
        class="ml-auto text-xs font-semibold px-3 py-1.5 rounded-full"
        style="background-color: var(--color-accent); color: #fff;"
      >
        Log
      </a>
    )}
  </div>

  <!-- Quick-action cards -->
  <div class="grid grid-cols-2 gap-3">
    <a
      href="/weight"
      class="rounded-2xl p-4 flex flex-col gap-2 transition-opacity active:opacity-70"
      style="background-color: var(--color-surface); border: 1px solid var(--color-border);"
    >
      <span class="text-2xl">📈</span>
      <span class="text-sm font-semibold" style="color: var(--color-text);">Weight Trend</span>
      <span class="text-xs" style="color: var(--color-muted);">
        {latest?.weightKg != null ? `Last: ${latest.weightKg} kg` : 'No data yet'}
      </span>
    </a>

    <a
      href="/workouts"
      class="rounded-2xl p-4 flex flex-col gap-2 transition-opacity active:opacity-70"
      style="background-color: var(--color-surface); border: 1px solid var(--color-border);"
    >
      <span class="text-2xl">🏋️</span>
      <span class="text-sm font-semibold" style="color: var(--color-text);">Workouts</span>
      <span class="text-xs" style="color: var(--color-muted);">Push · Pull · Legs</span>
    </a>

    <a
      href="/log"
      class="rounded-2xl p-4 flex flex-col gap-2 col-span-2 transition-opacity active:opacity-70"
      style="background-color: var(--color-surface); border: 1px solid var(--color-border);"
    >
      <span class="text-2xl">📋</span>
      <span class="text-sm font-semibold" style="color: var(--color-text);">Daily Log</span>
      <span class="text-xs" style="color: var(--color-muted);">
        Weight · Calories · Protein · Steps
      </span>
    </a>
  </div>
</AppLayout>
