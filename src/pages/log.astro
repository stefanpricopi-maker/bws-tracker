---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Daily Log">
  <div
    class="flex flex-col items-center justify-center gap-3 pt-16 text-center"
    style="color: var(--color-muted);"
  >
    <span class="text-5xl">📋</span>
    <p class="font-semibold" style="color: var(--color-text);">Daily Log — Phase 3</p>
    <p class="text-sm max-w-xs">
      The daily log form (weight, calories, protein, steps) will be built in the next phase.
    </p>
  </div>
</AppLayout>
