# ── Database ──────────────────────────────────────────────────────────────────
# Local: SQLite file
DATABASE_URL=file:./bws.db

# Production / staging (Turso LibSQL):
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# ── Optional app auth (multi-user ready; default user id=1 when unset) ───────
# BWS_AUTH_SECRET=long-random-string
# BWS_LOGIN_PASSWORD=your-app-password

# ── AI (Coach, weekly plan, vision) ───────────────────────────────────────────
AI_API_KEY=
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant

# ── USDA FoodData Central (meal macro estimate, free) ─────────────────────────
# Get key: https://fdc.nal.usda.gov/api-key-sign.html
FDC_API_KEY=

# ── Google Fit OAuth ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/google/callback

# ── Vercel Blob (progress photos) ─────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN=

# ── Node ──────────────────────────────────────────────────────────────────────
# NODE_ENV=development
