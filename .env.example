# ── Database ──────────────────────────────────────────────────────────────────
# Local dev (SQLite file):
DATABASE_URL=file:./bws.db

# Production (Turso/LibSQL remote):
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# ── Vision AI (Phase 9 — Scan Meal feature) ───────────────────────────────────
AI_API_KEY=sk-...
AI_MODEL=gpt-4o
# AI_API_BASE_URL=https://api.openai.com/v1   # default, change for other providers

# ── Google Fit OAuth (Phase 11) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/google/callback
